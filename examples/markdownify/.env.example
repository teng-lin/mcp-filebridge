# Copy to .env. NEVER commit real values.
MCP_BEARER_TOKEN=          # for Claude Code / Desktop; generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
# Self-hosted OAuth for the claude.ai/ChatGPT web connectors (front the TS backend):
MCP_OAUTH_PASSWORD=
MCP_OAUTH_BASE_URL=https://your-host.example.com   # bare https origin = the gateway's public URL
MCP_OAUTH_CLIENT_ID=                                # static client (Claude Advanced settings); disables open DCR
MCP_OAUTH_CLIENT_SECRET=
MCP_OAUTH_ALLOW_DCR=1                               # keep RFC 7591 as a fallback (ChatGPT)
# Public bucket endpoint baked into presigned URLs (R2/S3 in prod; local MinIO by default):
S3_PUBLIC_ENDPOINT=http://localhost:9101
PUBLIC_BASE_URL=http://localhost:8090
CF_TUNNEL_TOKEN=
