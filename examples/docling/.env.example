# Copy to .env (gitignored) and fill in. NEVER commit real values.
MCP_BEARER_TOKEN=              # Claude Code / Desktop; generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
# Self-hosted OAuth for the claude.ai web connector:
MCP_OAUTH_PASSWORD=
MCP_OAUTH_BASE_URL=https://docling.your-domain.example
MCP_OAUTH_CLIENT_ID=
MCP_OAUTH_CLIENT_SECRET=
MCP_OAUTH_ALLOW_DCR=1
# Bucket: default targets the bundled MinIO; prod = R2/S3 public endpoint.
S3_ACCESS_KEY=spikekey
S3_SECRET_KEY=spikesecret
S3_BUCKET=docling
S3_PUBLIC_ENDPOINT=http://localhost:9100
PUBLIC_BASE_URL=http://localhost:9500
MCP_HOST_PORT=9500
CF_TUNNEL_TOKEN=
