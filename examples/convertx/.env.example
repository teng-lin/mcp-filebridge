# Copy to .env (gitignored) and fill in. NEVER commit real values.

# --- Secrets you MUST set -------------------------------------------------- #
# Bearer token MCP clients (Claude Code / Desktop) present. Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave empty ONLY for purely-local testing on loopback.
MCP_BEARER_TOKEN=

# ConvertX signs its session cookies with this. Generate a random value.
CONVERTX_JWT_SECRET=

# The account the MCP server uses to drive ConvertX (self-created on first run).
CONVERTX_EMAIL=mcp@convertx.local
CONVERTX_PASSWORD=

# --- Bucket (defaults target the bundled MinIO) ---------------------------- #
S3_ACCESS_KEY=spikekey
S3_SECRET_KEY=spikesecret
S3_BUCKET=convertx
# PUBLIC endpoint baked into presigned URLs — must be reachable by the CLIENT
# (your browser / claude.ai's sandbox). Local MinIO = the published port below.
# PROD: set to your Cloudflare R2 / AWS S3 endpoint and remove the minio service.
S3_PUBLIC_ENDPOINT=http://localhost:9100

# --- Public URLs (prod) ---------------------------------------------------- #
# This MCP server's own public URL, used for the /u/<shortid> upload-widget links.
# Local = http://localhost:8080; prod = your tunnel hostname (https://...).
PUBLIC_BASE_URL=http://localhost:8080
# Host port to publish the MCP server on (change if 8080 is taken).
MCP_HOST_PORT=8080

# --- Optional: expose to claude.ai via a Cloudflare tunnel ----------------- #
# Cloudflare dashboard → Networks → Tunnels → your tunnel token. Route the
# public hostname to http://convertx-mcp:8080. Then: docker compose --profile cloudflare up -d
CF_TUNNEL_TOKEN=
