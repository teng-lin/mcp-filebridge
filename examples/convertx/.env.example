# Copy to .env (gitignored) and fill in. NEVER commit real values.

# --- Secrets you MUST set -------------------------------------------------- #
# Bearer token MCP clients (Claude Code / Desktop) present. Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave empty ONLY for purely-local testing on loopback.
MCP_BEARER_TOKEN=

# --- Self-hosted OAuth (only to connect from the claude.ai WEB connector, whose
# UI is OAuth-only). Bearer above keeps working for Claude Code/Desktop. Set BOTH
# or neither. PASSWORD gates authorization (>=16 chars, random). BASE_URL is the
# bare public https origin (no path). Generate the password:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
MCP_OAUTH_PASSWORD=
MCP_OAUTH_BASE_URL=https://your-host.example.com
# Static Client ID (recommended — disables open Dynamic Client Registration).
# Enter these two in Claude → connector → Advanced settings. Leave both unset to
# keep open DCR instead. Generate a secret: python -c "import secrets;print(secrets.token_urlsafe(24))"
# The claude.ai callback (https://claude.ai/api/mcp/auth_callback) is allowlisted
# by default; set MCP_OAUTH_REDIRECT_URIS (comma-separated) to add others.
MCP_OAUTH_CLIENT_ID=
MCP_OAUTH_CLIENT_SECRET=

# ConvertX signs its session cookies with this. Generate a random value.
CONVERTX_JWT_SECRET=

# The account the MCP server uses to drive ConvertX (self-created on first run).
CONVERTX_EMAIL=mcp@convertx.local
CONVERTX_PASSWORD=

# --- Shared object store --------------------------------------------------- #
# Private Docker-network endpoint used for server-side writes.
S3_ENDPOINT=http://object-store:9000
# Dedicated credentials provisioned only for the convertx bucket.
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=convertx
# PUBLIC endpoint baked into presigned URLs — must be reachable by the CLIENT
# (your browser / claude.ai's sandbox) and point at the same shared store.
S3_PUBLIC_ENDPOINT=https://s3.example.com

# --- Public URLs (prod) ---------------------------------------------------- #
# This MCP server's own public URL, used for the /u/<shortid> upload-widget links.
# Local = http://localhost:9400; prod = your tunnel hostname (https://...).
PUBLIC_BASE_URL=http://localhost:9400
# Host port to publish the MCP server on (change if 9400 is taken).
MCP_HOST_PORT=9400

# --- Optional: expose to claude.ai via a Cloudflare tunnel ----------------- #
# Cloudflare dashboard → Networks → Tunnels → your tunnel token. Route the
# public hostname to http://convertx-mcp:9400. Then: docker compose --profile cloudflare up -d
CF_TUNNEL_TOKEN=
